# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API). New-format keys work exactly like the old ones:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = the sb_publishable_... key   SUPABASE_SERVICE_ROLE_KEY = the sb_secret_... key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Branding / locale
NEXT_PUBLIC_PRODUCT_NAME=[PRODUCT_NAME]
NEXT_PUBLIC_DEFAULT_TZ=Africa/Cairo

# Public base URL (used for QR codes and magic links), e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sign-in e-mails the plan allows per hour (2 on the free Supabase plan); shown to the owner on the invite form. Change it when the plan or the sender changes.
NEXT_PUBLIC_AUTH_EMAIL_LIMIT_PER_HOUR=2

# Only for scripts (migrations over HTTPS, auth settings). Never used by the running app.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Bootstrap script only: the owner's login email
ORGANISER_EMAIL=

# Set to 1 on any project that hosts a real event: hides the platform owner's "Create demo organisation" button (the demo PINs are public).
DEMO_SEED_DISABLED=

# Ask Sendbook, the in-product assistant (server only; never exposed to the browser). Without the key the Ask button is hidden.
ANTHROPIC_API_KEY=
# Optional: the model that answers (default claude-sonnet-5-5) and the one that takes over when it fails (default claude-haiku-4-5)
ASK_SENDBOOK_MODEL=
ASK_SENDBOOK_FALLBACK_MODEL=
# Optional: questions per person per hour (default 30); 1 lets visitors on the public pages ask too (10 per address per hour; off by default)
ASK_SENDBOOK_HOURLY_LIMIT=
ASK_SENDBOOK_PUBLIC=
