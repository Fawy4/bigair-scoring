{
  "name": "bigair-scoring",
  "version": "0.14.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_PRODUCTION=1 playwright test e2e/admin-production.spec.ts",
    "lint": "eslint .",
    "seed:presets": "tsx scripts/seed-presets.ts",
    "db:apply": "node scripts/apply-sql.mjs",
    "db:status": "node scripts/apply-sql.mjs --status",
    "db:combine": "node scripts/combine-sql.mjs",
    "db:types": "node scripts/gen-types.mjs",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "bootstrap:organiser": "tsx scripts/bootstrap-organiser.ts",
    "bootstrap:platform-admin": "tsx scripts/bootstrap-platform-admin.ts",
    "auth:password": "node scripts/configure-auth.mjs --password-only",
    "test:e2e:budget": "E2E_PRODUCTION=1 playwright test e2e/public-budget.spec.ts",
    "preview:public": "tsx scripts/public-preview.ts",
    "manual:generate": "tsx scripts/manual-generate.ts",
    "manual:shots": "MANUAL_SHOTS=1 playwright test e2e/manual-shots.spec.ts --workers=1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.17.2",
    "next": "^15.5.26",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
